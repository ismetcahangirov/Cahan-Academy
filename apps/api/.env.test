# Test mühiti üçün saxta dəyərlər - real credentials deyil!
NODE_ENV=test
PORT=5001

# Saxta DB URL (testlər real DB-yə bağlanmır, mock istifadə edir)
DATABASE_URL=postgresql://test:test@localhost:5432/test_db
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/test_db

# JWT (32+ simvol)
JWT_SECRET=test_jwt_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=test_refresh_secret_key_minimum_32_chars_ok
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (saxta dəyərlər)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASS=test_smtp_password

# Client
CLIENT_URL=http://localhost:3000

# Email
ADMIN_EMAIL=admin@example.com
NOTIFICATION_EMAIL=notify@example.com
FROM_EMAIL=noreply@example.com

# Revalidate
REVALIDATE_SECRET=test_revalidate_secret_min_16

# Cloudinary (test values)
CLOUDINARY_CLOUD_NAME=test_cloud
CLOUDINARY_API_KEY=test_api_key
CLOUDINARY_API_SECRET=test_api_secret
