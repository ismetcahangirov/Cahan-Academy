# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Auth
# Access tokens (JWT_SECRET) and refresh tokens (JWT_REFRESH_SECRET): two DIFFERENT random values,
# at least 32 characters each, e.g. `openssl rand -hex 32`.
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_REFRESH_SECRET=another_different_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# URLs
CLIENT_URL=http://localhost:3000

# Emails
ADMIN_EMAIL=admin@cahanacademy.az
NOTIFICATION_EMAIL=notifications@cahanacademy.az

# Security
REVALIDATE_SECRET=your_revalidate_secret_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
